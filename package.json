{
  "name": "moingaymotdoan",
  "version": "0.1.0",
  "description": "Mỗi Ngày Một Đoạn — Đọc trọn bộ 66 sách, 1.189 đoạn Kinh Thánh bằng lời thường, kèm nguyên văn Bản Truyền Thống 1926, 100 chủ đề cảm xúc, ebook Kindle và lịch sử đọc đồng bộ. Luôn phi lợi nhuận & mã nguồn mở.",
  "license": "MIT",
  "homepage": "https://moingaymotdoan.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/tinwritescode/moingaymotdoan.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint src lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "import-bible": "node scripts/import-bible.mjs",
    "import-bible:en": "node scripts/import-bible-en.mjs",
    "mood:review": "MOOD_REVIEW_OUT=${MOOD_REVIEW_OUT:-mood-review.md} vitest run lib/moods/review.export.test.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/functions": "^0.11.0",
    "@solidjs/meta": "2.0.0",
    "@solidjs/router": "2.0.1",
    "@solidjs/web": "2.0.3",
    "@workos-inc/authkit-js": "^0.20.5",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "lottie-web": "5.12.2",
    "pg": "^8.23.1",
    "posthog-js": "^1.454.2",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@solidjs/diagnostics": "2.0.3",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "eslint-plugin-solid": "0.20.1",
    "filesystem-routing": "0.5.0",
    "jsdom": "31.0.1",
    "oxlint": "1.94.0",
    "svgpath": "^2.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}
