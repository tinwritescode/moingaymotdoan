# ==============================================================================
# Biến môi trường tùy chọn — bỏ trống toàn bộ vẫn chạy đọc & build tĩnh bình thường!
# Lịch sử đọc khi không đăng nhập sẽ tự động lưu tại trình duyệt (localStorage).
# ==============================================================================

# --- Frontend (WorkOS AuthKit PKCE + Reading History API) ---
# Client ID từ WorkOS Dashboard (khai báo Redirect URI: http://localhost:3000/tai-khoan và domain production)
VITE_WORKOS_CLIENT_ID=
# Tùy chọn: custom Auth API domain cùng gốc tên miền (bỏ trống để dùng api.workos.com)
VITE_WORKOS_API_HOSTNAME=
# URL của Neon Function xử lý API lịch sử đọc (ví dụ: https://<branch>-history.compute.<region>.aws.neon.tech)
VITE_HISTORY_API_URL=
# Khóa VAPID công khai cho lời nhắc đọc (Web Push). Cặp khóa: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Backend / Neon Function & Database migration (chỉ cần khi tự triển khai đồng bộ đám mây) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
WORKOS_CLIENT_ID=
WORKOS_API_HOSTNAME=

# PostHog project key (public, phc_…). Bỏ trống để tắt analytics.
VITE_POSTHOG_KEY=
